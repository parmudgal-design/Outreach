# Copy to .env in the repository root and fill in:  cp deploy/env.example .env && chmod 600 .env
# Never commit .env. It holds your API key, mail password and encryption key.
# The app reads it on start (./run.sh and Docker). Restart the app after editing it.
# A value set here wins over the Connections page, which then shows that field as locked.
# Leave a value empty to manage it from the Connections page instead.

# ---------------------------------------------------------------- Claude
# From console.anthropic.com → API keys. Empty = built-in templates instead of AI drafts.
ANTHROPIC_API_KEY=
# Optional: claude-opus-5-5 (default), claude-sonnet-5-5 or claude-haiku-4-5.
# ANTHROPIC_MODEL=claude-opus-5-5

# ---------------------------------------------------------------- Sending email (SMTP)
# dry_run records emails in the outbox and sends nothing. Change to smtp to send for real.
EMAIL_MODE=dry_run
# Gmail / Google Workspace shown. Zoho India: smtppro.zoho.in, 465, ssl.
# Outlook / Microsoft 365: smtp.office365.com, 587, starttls.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# ssl, starttls or none
SMTP_SECURITY=ssl
SMTP_USERNAME=
# For Gmail: an App Password (Google Account → Security → App passwords), not your normal password.
# Wrap it in quotes if it contains spaces or a #.
SMTP_PASSWORD=
# Empty = same as SMTP_USERNAME / your name from Setup.
FROM_EMAIL=
FROM_NAME=
REPLY_TO=

# ---------------------------------------------------------------- Reading replies (IMAP)
# true lets the app notice replies, bounces and unsubscribes.
IMAP_ENABLED=false
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
# Empty = same as the SMTP username and password.
IMAP_USERNAME=
IMAP_PASSWORD=
# IMAP_FOLDER=INBOX
# A person's own inbox that gets an email when someone replies. Empty = no alerts.
ALERT_TO=

# ---------------------------------------------------------------- Security

# Fernet key that encrypts the Anthropic API key and SMTP/IMAP passwords saved from the Connections page.
# (Values set in this file are never written to the database.) Optional when running on this computer.
# Generate with:  docker compose run --rm --no-deps app python -m backend.app.cli gen-key
#   (or, without Docker:  .venv/bin/python -m backend.app.cli gen-key)
# Store a copy in the team password manager. If it is lost, the API key and mail passwords
# must be re-entered; a backup restored later needs this same key. The app will not start
# with a wrong key once encrypted values exist.
OUTREACH_SECRET_KEY=

# The address people open the app at, used for the link in reply alert emails.
# OUTREACH_PUBLIC_URL=https://outreach.example.com

# ---------------------------------------------------------------- Hosting with Docker only
# Public hostname for the app. Its DNS A record must point at this server.
# DOMAIN=outreach.example.com
# Email Let's Encrypt uses for certificate expiry notices. Recommended.
# If you leave it empty, also delete the `email` line in deploy/Caddyfile.
# ACME_EMAIL=you@dr-tracker.com

# Optional tuning (defaults shown).
# OUTREACH_TICK_SECONDS=15
# OUTREACH_WORKER=1
